# Réglages du serveur en ligne. À copier en « .env » sur le VPS, puis à remplir.
# Ce fichier-ci est un exemple sans secret ; « .env » n'est jamais suivi par Git.
#
#     cp .env.exemple .env && nano .env
#
# Pour engendrer les mots de passe :
#     openssl rand -base64 24
# Pour l'empreinte du mot de passe d'accès à l'interface :
#     docker run --rm caddy:2-alpine caddy hash-password --plaintext 'votre-mot-de-passe'

# Nom de domaine qui pointe déjà vers ce serveur. Caddy obtient le certificat
# tout seul, mais seulement si l'enregistrement DNS existe avant le démarrage.
DOMAINE=sasi.example.com

# Accès à l'interface. Garde provisoire, tant que les comptes réels ne sont pas
# faits : sans elle, n'importe qui pourrait clôturer les alertes du site.
#
# L'empreinte doit être entre GUILLEMETS SIMPLES. Elle contient des « $ », que
# docker compose comme bash prendraient autrement pour des noms de variables :
# l'empreinte arriverait tronquée et le mot de passe serait refusé.
ACCES_UTILISATEUR=william
ACCES_EMPREINTE='$2a$14$remplacez-moi-par-la-sortie-de-caddy-hash-password'

# Base de données. Jamais exposée hors du réseau des conteneurs.
MOT_DE_PASSE_BASE=changez-moi

# Serveur de messages. Le compte est créé par outils/deployer.sh à partir de ces
# deux lignes : si vous les modifiez, relancez-le.
MQTT_UTILISATEUR=sasi
MQTT_MOT_DE_PASSE=changez-moi-aussi

# Adresse à laquelle Let's Encrypt signale un renouvellement en souffrance.
# C'est le seul moyen d'être averti avant l'expiration d'un certificat.
COURRIEL_ADMINISTRATEUR=vous@exemple.com

# Site surveillé, tel que nommé dans sites/<nom>.json
SASI_SITE=brasserie

# Démonstration : une panne provoquée toutes les N secondes par le jumeau
# provisoire. 900 = un quart d'heure.
PERIODE_PANNE_S=900
