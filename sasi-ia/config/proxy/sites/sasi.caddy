# SASI — surveillance thermique prédictive.
# L'application rejoint le réseau « frontal » sous le nom « sasi-api ».

{$DOMAINE_SASI:sasi.the7ing.site} {
	encode zstd gzip

	# Accès libre, sur décision de William le 25/10/2026.
	#
	# Ce qu'il faut en savoir : l'application n'a pas encore de comptes réels —
	# le rôle se choisit dans une liste — et elle permet d'acquitter et de
	# clôturer des alertes, de signaler un échauffement, et de lancer un
	# entraînement, lequel occupe les deux cœurs du serveur plusieurs minutes.
	# Qui connaît l'adresse peut tout cela.
	#
	# Pour rétablir la garde, décommentez ce bloc et relancez le frontal
	# (ACCES_UTILISATEUR et ACCES_EMPREINTE sont restés dans .env) :
	#
	#     basic_auth {
	#         {$ACCES_UTILISATEUR} {$ACCES_EMPREINTE}
	#     }
	#
	# Pour un accès libre en consultation mais gardé sur les actions, la garde
	# se limite aux méthodes qui modifient :
	#
	#     @ecritures method POST PUT PATCH DELETE
	#     basic_auth @ecritures {
	#         {$ACCES_UTILISATEUR} {$ACCES_EMPREINTE}
	#     }

	# Le serveur d'application sert aussi l'interface compilée ; le suivi en
	# temps réel passe par la même adresse et Caddy le relaie sans réglage.
	reverse_proxy sasi-api:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/sasi.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
